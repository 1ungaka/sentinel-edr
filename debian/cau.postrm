#!/bin/sh
# Remove the unprivileged system user only when the package is purged: a
# "remove" and reinstall must keep the uid the files under /var/lib/cau were
# written with, and an operator's quarantine vault is not ours to delete.
set -e

case "$1" in
    purge)
        if getent passwd cau >/dev/null; then
            deluser --system cau >/dev/null 2>&1 || true
            delgroup --system cau >/dev/null 2>&1 || true
        fi
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
esac

#DEBHELPER#

exit 0
