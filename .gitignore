# Build output
/cau
/cau-mcp
/cau.exe
/dist/
/bin/

# Packaging build output: Debian's debian/ tree and the Arch build dirs are
# build products of the respective builders, never checked in. The sources
# that ARE tracked live in debian/ (control, rules, postinst, postrm, docs,
# watch, changelog, copyright) and packaging/arch/ (PKGBUILD, .SRCINFO).
# dpkg-buildpackage and makepkg both leave their artifacts in the repository
# root and in debian/.
/cau_*.deb
/cau_*.dsc
/cau_*.debian.tar.*
/cau_*.build
/cau_*.buildinfo
/cau_*.changes
/debian/cau/
/debian/cau.*/
/debian/*.debhelper
/debian/*.debhelper.log
/debian/*.substvars
/debian/files
/debian/.debhelper/
/debian/.gocache/
/packaging/arch/pkg/
/packaging/arch/src/
/packaging/arch/*.pkg.tar.*
/packaging/arch/cau
/packaging/arch/cau-mcp
/aptrepo/

# Go
*.test
*.out
*.prof
/coverage.*

# Editors / OS
.idea/
.vscode/
*.swp
*.kate-swp
.DS_Store

# Local scratch: never commit real samples
/samples/
/corpus/local/
/corpus/**/*.exe
/corpus/**/*.dll
/eval-out/

# Held-out recall corpus: the encrypted hash database (hashes.db, ciphertext)
# and the README are tracked; the fetched malware samples, the generated live
# manifest, the download cache and any temp file never are.
/corpus/heldout/samples/
/corpus/lab/
/corpus/heldout/manifest.json
/corpus/heldout/.heldout-download.zip
/corpus/heldout/*.tmp

# Self-scan output: the workflow ci.yml (selfscan lane) writes both reports at
# the repository root and uploads them to code scanning and the run artifacts;
# they are run output, never source.
/cau.sarif
/cau.ocsf.json

# Nested and local-only trees that are not this repository: cau-kernel is a
# separate repo living inside the checkout, and the rest is untracked work in
# progress (a workflow-linting tool, a draft document).
/cau-kernel/
/scripts/lintworkflows/
/docs/p.p
