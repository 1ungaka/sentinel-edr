# Schedules cau-scan.service. Daily at 02:00 with a randomized delay, and a
# catch-up run if the machine was off at the scheduled time. Edit OnCalendar to
# taste (e.g. "hourly", "*-*-* 00/6:00:00" for every six hours).
#
# Install: see cau-scan.service. Enable with:
#   systemctl enable --now cau-scan.timer
# Inspect: systemctl list-timers cau-scan.timer
[Unit]
Description=Schedule for CAU EDR scheduled scan
Documentation=https://github.com/s-b-repo/cau

[Timer]
OnCalendar=*-*-* 02:00:00
RandomizedDelaySec=30m
Persistent=true
Unit=cau-scan.service

[Install]
WantedBy=timers.target
