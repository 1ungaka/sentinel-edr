# Oneshot scan unit, driven by cau-scan.timer. Runs a single cau scan and exits;
# systemd handles the scheduling. This is the scheduled-scan pattern — prefer it
# over the resident daemon when you only need periodic scans.
#
# Install: copy this file and cau-scan.timer to /etc/systemd/system/, edit the
# scan path and options below, then:
#   systemctl daemon-reload && systemctl enable --now cau-scan.timer
#
# Reports are written under ReadWritePaths; adjust the path and --output to taste.
[Unit]
Description=CAU EDR scheduled scan
Documentation=https://github.com/1ungaka/sentinel-edr
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Defense in depth: verify detection content has not been tampered with before
# each scan. Record the baseline once on a known-good install
# (cau selftest --record, ideally --sign-key), then this fails the run if the
# signature DB or rules drifted. Drop the "-" prefix to make drift hard-fail.
ExecStartPre=-/usr/bin/cau selftest
# Edit the scan target(s), format and output path for your host.
ExecStart=/usr/bin/cau scan --dir / --format sarif --output /var/log/cau/scan.sarif --fail-on none --quiet
# A finding must not make the unit "failed"; the report carries the verdict.
SuccessExitStatus=0 1 2
Nice=15
IOSchedulingClass=idle

# ── Least privilege ─────────────────────────────────────────────────────────
# Run unprivileged; one capability grants read-any-file instead of full root.
#   useradd --system --no-create-home --shell /usr/sbin/nologin cau
User=cau
Group=cau
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
StateDirectory=cau
LogsDirectory=cau
UMask=0077

# ── Sandbox / anti-tamper ───────────────────────────────────────────────────
# The scanner only reads the filesystem and writes its own report/vault dirs.
ProtectSystem=strict
ReadWritePaths=/var/log/cau /var/lib/cau
# For --quarantine, the vault lives under /var/lib/cau (already writable above).
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
