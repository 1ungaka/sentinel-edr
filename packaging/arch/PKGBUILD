# Maintainer: Stephan Botes <stephanbotes0@gmail.com>
pkgname=cau
pkgver=0.1.0
pkgrel=1
pkgdesc='transparent open-source malware detection engine: explained verdicts, labeled classes, ATT&CK techniques'
arch=('x86_64')
url='https://github.com/s-b-repo/cau'
license=('MIT')
depends=('glibc' 'yara')
makedepends=('go' 'pkgconf')
optdepends=('systemd: scheduled and resident scanning units'
            'bash-completion: bash completion for cau'
            'zsh: zsh completion for cau'
            'fish: fish completion for cau')
provides=('cau-edr')
source=("https://github.com/s-b-repo/cau/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
# The release asset, not the per-request /archive/ URL: GitHub regenerates the
# archive for every request and the bytes are not stable, so a checksum taken
# from one fetch is not the bytes the next fetcher downloads.
#
# Where this value comes from: sha256sum of the cau-0.1.0.tar.gz published at
# the source URL above, which is what makepkg validates. It is not reproducible
# locally and need not be: the release job builds the tarball with a fixed epoch,
# sorted names and zeroed owner/group out of a tree that excludes packaging/
# (see .gitattributes), so the asset depends on the tagged source alone, and the
# same runner image produces the same bytes for the same source. Refresh it with
# updpkgsums or by hashing the published asset after a new tag (see
# docs/packaging.md).
sha256sums=('7249f2a9e90614272e50e0e12ce869455f67b64ece3b768251beeb25d06f266d')

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    # The vendored Go module tree is committed, so the build needs no network
    # and no module cache; -mod=vendor makes a missing vendor/ fail loudly
    # instead of falling back to a fetch.
    export CGO_ENABLED=1
    export GOFLAGS='-mod=vendor'
    export GOPROXY=off
    # -trimpath keeps the build reproducible, as in the Debian package.
    go build -trimpath -ldflags "-X main.version=${pkgver}" -o cau .
    go build -trimpath -ldflags "-X main.version=${pkgver}" -o cau-mcp ./cmd/cau-mcp
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    # The same install target the Debian package drives: one install path, two
    # packagers, so the two cannot drift. It already places the binary, the
    # content, the man pages, the shell completions, the license and the
    # systemd units.
    #
    # VERSION is passed explicitly because a release tarball carries no .git:
    # without it, `make install` re-stamps the binary as "dev" and overwrites
    # the one built above with an unversioned build.
    make install install-systemd PREFIX=/usr DESTDIR="${pkgdir}" VERSION="${pkgver}"
}
