# Lintian overrides for cau, with the reason each one is deliberate.
#
# cau installed audits the maintainer and install-time scripts of installed
# packages in place, offline and read-only, and dpkg's own metadata under
# /var/lib/dpkg/info is where those scripts live
# (docs/architecture.md, "cau installed"). Reading it is the feature, so the
# dpkg database warning is overridden rather than the capability removed.
cau: uses-dpkg-database-directly

# Debian's archive wants an initial upload to close its ITP bug. This package is
# not filed there yet — it ships from its own releases and a maintainer-hosted
# repository (docs/packaging.md) — so there is no bug number to close. When it
# is filed, delete this override and add the "Closes: #nnnnnn" line to
# debian/changelog instead.
cau: initial-upload-closes-no-bugs
